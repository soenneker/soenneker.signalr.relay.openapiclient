    "/api/hubs/{hub}/:send": {
      "post": {
        "operationId": "Broadcast",
        "parameters": [
          {
            "name": "hub",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "description": "Optional nonempty GUID. Reuse for the same request within the five-minute retention window.",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "api-version",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "excluded",
            "in": "query",
            "description": "Connection IDs omitted from delivery.",
            "style": "form",
            "explode": true,
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        ],
        "responses": {
          "202": {
            "description": "Send accepted."
          },
          "400": {
            "description": "Invalid request or unsupported application query parameter."
          },
          "401": {
            "description": "Missing or invalid path-scoped bearer token."
          },
          "409": {
            "description": "The idempotency key was used for a different request."
          },
          "413": {
            "description": "Request or retained reply exceeds its size limit."
          },
          "415": {
            "description": "A JSON request body is required."
          },
          "429": {
            "description": "The relay has reached its operation limit."
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ManagementInvocation"
              }
            }
          }
        }
      }
    },
