          {
            "name": "api-version",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "SignalR JSON completion terminated by byte 0x1e.",
            "content": {
              "application/octet-stream": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            },
            "headers": {
              "X-ASRS-Protocol": {
                "schema": {
                  "type": "string",
                  "example": "json"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request or unsupported application query parameter."
          },
          "401": {
            "description": "Missing or invalid path-scoped bearer token."
          },
          "404": {
            "description": "The target connection was not found."
          },
          "409": {
            "description": "The idempotency key was used for a different request."
          },
          "410": {
            "description": "Client disconnected."
          },
          "413": {
            "description": "Request or retained reply exceeds its size limit."
          },
          "415": {
            "description": "A JSON request body is required."
          },
          "429": {
            "description": "The relay has reached its operation limit."
          },
          "504": {
            "description": "Client completion timed out."
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ManagementInvocation"
              }
            }
          }
        }
      }
    },
